<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lanmessenger</groupId>
        <artifactId>lan-messenger</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>client</artifactId>
    <packaging>jar</packaging>

    <name>LAN Messenger :: Client</name>
    <description>JavaFX desktop application for the LAN Messenger.</description>

    <properties>
        <!-- Test stack, matching the server module so tests run consistently. -->
        <junit.version>5.12.1</junit.version>
        <surefire.plugin.version>3.5.4</surefire.plugin.version>
    </properties>

    <dependencies>
        <!-- Shared protocol constants and message model. -->
        <dependency>
            <groupId>com.lanmessenger</groupId>
            <artifactId>common</artifactId>
        </dependency>

        <!-- JavaFX. 'controls' transitively brings base + graphics, which is all
             the UI needs for now. Platform-specific natives are resolved by Maven. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- SQLite via JDBC for local chat persistence. The database layer lives in
             'client.data' (pure JDBC) and is bridged to the UI by 'client.history'. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>

        <!-- Test scope only: the client networking integration tests exercise the
             layer against the real ChatServer over loopback sockets. This never
             leaks into the client's runtime/packaged artifact. -->
        <dependency>
            <groupId>com.lanmessenger</groupId>
            <artifactId>server</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 for the networking integration tests (test scope only). -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Runs the JavaFX application with:
                    mvn -pl client javafx:run
                The plugin builds the JavaFX module path automatically, so we do
                not need a module-info.java for this project.
            -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.plugin.version}</version>
                <configuration>
                    <mainClass>com.lanmessenger.client.ClientApp</mainClass>
                    <!-- JavaFX loads native libraries; on JDK 24+ this flag
                         grants native access so no runtime warning is printed.
                         The SQLite JDBC driver also loads a native library and
                         runs on the class path (unnamed module), so ALL-UNNAMED
                         is included in the same flag. -->
                    <options>
                        <option>--enable-native-access=javafx.graphics,ALL-UNNAMED</option>
                    </options>
                </configuration>
            </plugin>

            <!-- Pinned so JUnit 5 tests run consistently across environments. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.plugin.version}</version>
                <configuration>
                    <!-- The persistence tests exercise the SQLite JDBC driver, which
                         loads a native library from the class path; grant native
                         access so no warning is printed during the test run. -->
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Packaging profile used by the Windows release scripts (scripts/build-release.ps1).
            It stages every runtime dependency (the shared 'common' module, JavaFX
            including its Windows native jars, and the SQLite JDBC driver) into
            target/dist/lib. The release script then adds this module's own jar and
            hands the whole flat directory to jpackage as the application class path.

            Activate with:  mvn -Pdist clean package
        -->
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>${dependency.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>copy-runtime-dependencies</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <!-- Flat directory of jars that jpackage will bundle. -->
                                    <outputDirectory>${project.build.directory}/dist/lib</outputDirectory>
                                    <!-- Runtime scope keeps test-only deps (JUnit, the
                                         test-scoped server module) out of the package. -->
                                    <includeScope>runtime</includeScope>
                                    <overWriteReleases>true</overWriteReleases>
                                    <overWriteSnapshots>true</overWriteSnapshots>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
