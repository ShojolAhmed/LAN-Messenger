<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.lanmessenger</groupId>
    <artifactId>lan-messenger</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>LAN Messenger</name>
    <description>A modern JavaFX LAN messenger with a central TCP server.</description>

    <!--
        This is the parent (aggregator) project. It builds three modules:
          - common : shared protocol/model code used by both client and server
          - server : the central TCP server that routes messages
          - client : the JavaFX desktop application
    -->
    <modules>
        <module>common</module>
        <module>server</module>
        <module>client</module>
    </modules>

    <properties>
        <!-- Compile for Java 21 (LTS). The installed JDK 25 runs this without issue. -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency / plugin versions kept in one place for easy maintenance. -->
        <javafx.version>21.0.5</javafx.version>
        <compiler.plugin.version>3.13.0</compiler.plugin.version>
        <javafx.plugin.version>0.0.8</javafx.plugin.version>
        <exec.plugin.version>3.5.0</exec.plugin.version>

        <!-- SQLite (JDBC) for local chat persistence. Used only by the client. -->
        <sqlite.jdbc.version>3.50.3.0</sqlite.jdbc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal shared module. Modules reference it without repeating the version. -->
            <dependency>
                <groupId>com.lanmessenger</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- SQLite JDBC driver (bundles the native SQLite engine). Version is
                 pinned here so modules can depend on it without repeating it. -->
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite.jdbc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
