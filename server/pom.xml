<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lanmessenger</groupId>
        <artifactId>lan-messenger</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>server</artifactId>
    <packaging>jar</packaging>

    <name>LAN Messenger :: Server</name>
    <description>Central TCP server that accepts connections and (later) routes messages.</description>

    <properties>
        <!-- Test stack. Surefire 3.5.4 is already cached locally and runs JUnit 5. -->
        <junit.version>5.12.1</junit.version>
        <surefire.plugin.version>3.5.4</surefire.plugin.version>
    </properties>

    <dependencies>
        <!-- Shared protocol constants and message model. -->
        <dependency>
            <groupId>com.lanmessenger</groupId>
            <artifactId>common</artifactId>
        </dependency>

        <!-- JUnit 5 for the server integration tests (test scope only). -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Convenience plugin so the server can be started with:
                    mvn -pl server exec:java
                The main class is pre-configured, so no extra flags are needed.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.plugin.version}</version>
                <configuration>
                    <mainClass>com.lanmessenger.server.ServerApplication</mainClass>
                </configuration>
            </plugin>

            <!-- Pinned so JUnit 5 tests run consistently across environments. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.plugin.version}</version>
            </plugin>
        </plugins>
    </build>

</project>
